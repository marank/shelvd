# Copy to .env and adjust. Native development reads it directly (backend/config/settings.py);
# docker compose passes it into the app container and overrides a few values (see below).

# --- Application ----------------------------------------------------------------
# Every URL users open shelvd under, comma separated (scheme, host and port if not
# default). Allowed hosts, CSRF trusted origins and secure cookies are derived from it;
# use https URLs only once a TLS proxy is in front.
APP_URLS=http://localhost:8080
# Port published on the host. Native development: Vite's port (the URL you open).
APP_PORT=8080
# Native development only: port of Django's runserver, Vite proxies /api etc. to it.
# BACKEND_PORT=8000
# Native development only: Vite with a self-signed certificate 
# (add https://<LAN IP>:<APP_PORT> to APP_URLS).
# DEV_HTTPS=false

# Address(es) of a TLS proxy in front of shelvd (comma separated IPs or CIDR ranges).
# Only from these nginx accepts X-Forwarded-For/-Proto, i.e. the client's address and
# HTTPS. Required with https URLs in APP_URLS. Empty: clients connect directly.
TRUSTED_PROXIES=

# Long random string (at least 40 characters; shelvd refuses to start otherwise), e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# With DEBUG=true a fixed development key is used while this is still the placeholder.
SECRET_KEY=change-me
# true for native development (runserver, Vite). docker compose always sets false.
DEBUG=true
# Serve the Django admin under /admin. Defaults to the value of DEBUG; set true to
# expose it in the Docker setup as well.
# ADMIN_ENABLED=false
TIME_ZONE=Europe/Berlin
# Default language of server messages when the browser asks for none of de/en.
LANGUAGE_CODE=de
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- First administrator (created on first start if the user does not exist) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=it@example.com
# Only used when the user is created; change it later with
#   docker compose exec app python manage.py set_password admin
ADMIN_PASSWORD=change-me

# Let people create their own account on the login page (true/false). Off: accounts
# are created by an admin (Django admin or `manage.py createsuperuser`).
REGISTRATION_ENABLED=false

# Load the add-ons found in backend/addons/ (copied in by an add-on's own build; none are
# part of shelvd itself). false: run shelvd as published. Default: true.
# ADDONS_ENABLED=true

# -------------------------------------------------------------------- external services
# IGDB, HowLongToBeat, OpenCritic, TheGamesDB and ScreenScraper are set up by an
# admin in the app (Integrations page); keys are stored encrypted with SECRET_KEY – change
# SECRET_KEY and they have to be entered again. docs/data-sources.md compares the sources.
# Seconds before a request to one of them gives up.
PROVIDER_TIMEOUT=10
# Largest cover image upload in megabytes.
COVER_MAX_MB=10

# ------------------------------------------------------------------------------ email
# SMTP server for mails from shelvd (none are sent yet; DEBUG prints them instead).
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_FROM=shelvd@example.com

# --------------------------------------------------------------------------- database
# sqlite (file backend/db.sqlite3) or postgres. docker compose always runs Postgres
# with the values below and sets DB_TYPE=postgres, DB_HOST=db and DEBUG=false inside the
# container.
DB_TYPE=sqlite
DB_NAME=shelvd
DB_USER=shelvd
DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# Postgres only: seconds a database connection is kept open for the next requests
# (0 = a new connection for every request). Default: 60.
# DB_CONN_MAX_AGE=60

# --------------------------------------------------------------------------- backups
# docker compose runs a nightly pg_dump into the "backups" volume (docker/backup.sh).
# Time of day in TIME_ZONE, and how many days of dumps to keep.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# --------------------------------------------------------------------------- server
# Gunicorn worker processes in the app container; each handles one request at a time
# and needs roughly 50-150 MB RAM. Rule of thumb: 2 x CPU cores + 1. Default: 3.
# GUNICORN_WORKERS=3
# Writable data directory (uploads etc.). Natively backend/data; the container uses
# its /data volume.
# DATA_DIR=
