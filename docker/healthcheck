"""HTTP probe against the app inside the container, sent like a request for the first
APP_URLS host (Django only accepts its own hosts) and, for https URLs, marked as https.

  healthcheck                      GET /api/health, expect 200 (Docker HEALTHCHECK)
  healthcheck <path> <status>      any path and expected status (CI smoke test)

The https marker only counts when nginx trusts 127.0.0.1 (TRUSTED_PROXIES); otherwise
nginx overwrites it and Django sees plain http, which /api/health is exempt for.
"""

import os
import sys
import urllib.error
import urllib.request
from urllib.parse import urlsplit


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None  # report 301/302 as they are


def main() -> int:
    path = sys.argv[1] if len(sys.argv) > 1 else "/api/health"
    expected = int(sys.argv[2]) if len(sys.argv) > 2 else 200

    first_url = (os.environ.get("APP_URLS") or "http://localhost").split(",")[0].strip()
    parts = urlsplit(first_url)
    request = urllib.request.Request(
        "http://127.0.0.1:8080" + path,
        headers={"Host": parts.netloc or "localhost", "X-Forwarded-Proto": parts.scheme or "http"},
    )
    opener = urllib.request.build_opener(NoRedirect)
    try:
        status = opener.open(request, timeout=5).status
    except urllib.error.HTTPError as error:
        status = error.code
    except OSError as error:
        print(f"{path}: {error}")
        return 1
    print(f"{path}: {status}")
    return 0 if status == expected else 1


if __name__ == "__main__":
    sys.exit(main())
